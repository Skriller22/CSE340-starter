<% if (title) { %>
  <h1><%= title %></h1>
  <% } else {
    res.redirect("/")
  } %>

  <%# messages() %>
  <%- messages() %>
  <% if (errors) { %>
  <ul class="notice">
    <% const list = Array.isArray(errors) ? errors : errors.array() 
    list.forEach(error => {
    %>
      <li><%= error.msg %></li>
    <% }) %>
      </ul>
    <% } %>

<div class="delete-account-view">
  <form action="/account/delete-account" method="post">

    <!-- Hidden ID -->
    <input type="hidden" name="account_id" value="<%= account.account_id %>">

    <label for="account_name">Account Name</label>
    <input 
      type="text" 
      id="account_name" 
      name="account_name" 
      value="<%= account.account_firstname %> <%= account.account_lastname %>" 
      required readonly
    >
    <label for="account_email">Account Email</label>
    <input 
      type="email" 
      id="account_email" 
      name="account_email" 
      value="<%= account.account_email %>" 
      required readonly
    >

    <p id="confirm-delete">Confirm Deletion - This process cannot be undone</p>
    <button type="submit" class="button">Delete Account</button>
  </form>
</div>