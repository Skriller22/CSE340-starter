<% if (title) { %>
  <h1><%= title %></h1>
  <% } else {
    res.redirect("/")
  } %>

<%- messages() %>

<% if (order) { %>

  <div class="order-detail-container">
    
    <div class="detail-breadcrumb">
      <a href="/custom/my-orders">← Back to My Orders</a>
    </div>

    <div class="detail-content">
      
      
      <div class="detail-main">
        
        <div class="vehicle-header">
          <div class="vehicle-info">
            <h2 class="vehicle-title"><%= order.order_year %> <%= order.order_make %> <%= order.order_model %></h2>
          </div>
        </div>
        
        <div class="status-section">
          <span class="status-badge status-<%= order.order_status.toLowerCase().replace(/\s+/g, '-') %>">
            <%= order.order_status %>
          </span>
        </div>
        <div class="detail-section">
        <h3>Order Information</h3>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="item-label">Order ID</span>
                <span class="item-value">#<%= order.order_id %></span>
            </div>
            <div class="detail-item">
                <div class="vehicle-color">
                    <span class="item-label">Color:</span>
                    <span class="color-swatch" data-color-swatch="<%= order.order_color %>"></span>
                </div>
            </div>
            <div class="detail-item">
              <span class="item-label">Status</span>
              <span class="item-value"><%= order.order_status %></span>
            </div>
            <div class="detail-item">
              <span class="item-label">Date Submitted</span>
              <span class="item-value"><%= new Date(order.order_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
            <div class="detail-item">
              <span class="item-label">Estimated Budget</span>
              <span class="item-value price">$<%= new Intl.NumberFormat('en-US').format(order.order_estimated_price) %></span>
            </div>
          </div>
        </div>

        <div class="detail-section">
          <h3>Vehicle Specifications</h3>
          <div class="detail-grid">
            <div class="detail-item">
              <span class="item-label">Make</span>
              <span class="item-value"><%= order.order_make %></span>
            </div>
            <div class="detail-item">
              <span class="item-label">Model</span>
              <span class="item-value"><%= order.order_model %></span>
            </div>
            <div class="detail-item">
              <span class="item-label">Year</span>
              <span class="item-value"><%= order.order_year %></span>
            </div>
            <div class="detail-item">
              <span class="item-label">Color</span>
              <span class="item-value"><%= order.order_color %></span>
            </div>
          </div>
        </div>

        <div class="detail-section">
          <h3>Build Description</h3>
          <div class="description-box">
            <p><%= order.order_description %></p>
          </div>
        </div>

        <% if (order.order_notes) { %>
          <div class="detail-section admin-notes">
            <h3>Admin Notes</h3>
            <div class="notes-box">
              <p><%= order.order_notes %></p>
            </div>
          </div>
        <% } %>

      </div>

      <div class="detail-sidebar">
        
        <div class="status-timeline">
          <h3>Order Status Timeline</h3>
          <div class="timeline">
            <div class="timeline-item <%= order.order_status === 'Pending' || ['In Review', 'Approved', 'In Production', 'Completed'].includes(order.order_status) ? 'completed' : '' %>">
              <div class="timeline-marker"></div>
              <div class="timeline-text">
                <strong>Pending</strong>
                <small>Order received</small>
              </div>
            </div>

            <div class="timeline-item <%= ['In Review', 'Approved', 'In Production', 'Completed'].includes(order.order_status) ? 'completed' : '' %>">
              <div class="timeline-marker"></div>
              <div class="timeline-text">
                <strong>In Review</strong>
                <small>Team reviewing</small>
              </div>
            </div>

            <div class="timeline-item <%= ['Approved', 'In Production', 'Completed'].includes(order.order_status) ? 'completed' : '' %>">
              <div class="timeline-marker"></div>
              <div class="timeline-text">
                <strong>Approved</strong>
                <small>Ready to build</small>
              </div>
            </div>

            <div class="timeline-item <%= ['In Production', 'Completed'].includes(order.order_status) ? 'completed' : '' %>">
              <div class="timeline-marker"></div>
              <div class="timeline-text">
                <strong>In Production</strong>
                <small>Building your car</small>
              </div>
            </div>

            <div class="timeline-item <%= order.order_status === 'Completed' ? 'completed' : '' %>">
              <div class="timeline-marker"></div>
              <div class="timeline-text">
                <strong>Completed</strong>
                <small>Ready for pickup</small>
              </div>
            </div>
          </div>
        </div>

        <div class="order-actions-sidebar">
          <h3>Actions</h3>
          <% if (order.order_status === 'Pending') { %>
            <a href="/custom/delete/<%= order.order_id %>" class="btn-action btn-delete" onclick="return confirm('Are you sure? This action cannot be undone.');">
              Delete Order
            </a>
          <% } %>
          <a href="/custom/my-orders" class="btn-action btn-secondary">
            Back to Orders
          </a>
        </div>

      </div>

    </div>

  </div>

<% } %>